# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=cosmetic_ad_rules
QDRANT_API_KEY=

# BM25 Sparse Index File Path
BM25_INDEX_PATH=data/02_processed/bm25_index.pkl

# Judge Backend (rule | gpt | ft)
JUDGE_BACKEND=rule

# Fine-tuned Model / Adapter Path (Used when JUDGE_BACKEND=ft)
FT_ADAPTER_PATH=finetune/adapters/qwen_ad_judge_v1

# Ops & Observability
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cosmetic-ad-agent

# API Server & Client
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
