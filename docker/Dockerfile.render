FROM python:3.11-slim

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir .

COPY configs ./configs
COPY data/assets ./data/assets
COPY data/01_raw ./data/01_raw
COPY data/market_reference ./data/market_reference
COPY data/02_processed/chunks.jsonl ./data/02_processed/chunks.jsonl
COPY indexing/05_build_indexes.py ./indexing/05_build_indexes.py
COPY api ./api
COPY app ./app
COPY .streamlit/config.toml ./.streamlit/config.toml
COPY scripts/start_render.py ./scripts/start_render.py

# Generate only the local keyword index; no API keys or embedding calls at build time.
RUN python -c "import runpy; m = runpy.run_path('indexing/05_build_indexes.py'); m['build_bm25_index'](m['load_chunks'](), m['DEFAULT_BM25_PATH'])"

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src:/app \
    API_BASE_URL=http://127.0.0.1:8000 \
    UI_DATA_MODE=api \
    PORT=10000

EXPOSE 10000
CMD ["python", "scripts/start_render.py"]
