{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Internal creative performance; requires an actual campaign export",
  "type":"object",
  "additionalProperties":false,
  "required":["record_kind","campaign_id","creative_id","creative_version","copy_text","product_id","offer_id","channel","market","audience_id","image_asset_version","period_start","period_end","attribution_window","currency","impressions","clicks","sessions","purchases","net_revenue","ad_spend","export_source","source_kind","experiment_id","experiment_arm","randomization_verified"],
  "properties":{
    "record_kind":{"const":"observed_internal_performance"},
    "campaign_id":{"type":"string","minLength":1},
    "creative_id":{"type":"string","minLength":1},
    "creative_version":{"type":"string","minLength":1},
    "copy_text":{"type":"string","minLength":1},
    "product_id":{"type":"string","minLength":1},
    "offer_id":{"type":"string","minLength":1},
    "channel":{"type":"string","minLength":1},
    "market":{"type":"string","minLength":1},
    "audience_id":{"type":["string","null"],"description":"실제 광고 타깃 그룹 ID. 시험 참여자나 제품 권장 피부타입으로 대체 금지"},
    "image_asset_version":{"type":["string","null"]},
    "period_start":{"type":"string","format":"date-time"},
    "period_end":{"type":"string","format":"date-time"},
    "attribution_window":{"type":"string","minLength":1},
    "currency":{"const":"KRW"},
    "impressions":{"type":["integer","null"],"minimum":0},
    "clicks":{"type":["integer","null"],"minimum":0},
    "sessions":{"type":["integer","null"],"minimum":0},
    "purchases":{"type":["integer","null"],"minimum":0},
    "net_revenue":{"type":["number","null"],"description":"합의한 반품·취소·세금 기준을 기록. 관측 0과 미확인 null을 구분"},
    "ad_spend":{"type":["number","null"],"minimum":0},
    "export_source":{"type":"string","minLength":1},
    "source_kind":{"enum":["ad_platform_export","analytics_export","order_attribution_export"]},
    "experiment_id":{"type":["string","null"]},
    "experiment_arm":{"type":["string","null"]},
    "randomization_verified":{"type":"boolean"},
    "copy_reference_ids":{"type":"array","items":{"type":"string"},"description":"참고한 공개 문구 ID. 참고 관계이며 외부 브랜드 실적을 이전하지 않음"},
    "price_krw":{"type":["number","null"],"minimum":0},
    "discount_pct":{"type":["number","null"],"minimum":0,"maximum":100},
    "refund_count":{"type":["integer","null"],"minimum":0},
    "complaint_count":{"type":["integer","null"],"minimum":0},
    "measurement_notes":{"type":"string"}
  }
}
